{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "gpx.studio",
    "version": "0.1.0",
    "identifier": "gpx.studio",
    "build": {
        "beforeDevCommand": "npm --prefix ../website run dev -- --port 4283",
        "devUrl": "http://localhost:4283/app",
        "beforeBuildCommand": "BASE_PATH='' npm --prefix ../website run build",
        "frontendDist": "../website/build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "gpx.studio",
                "url": "app.html",
                "width": 1400,
                "height": 900,
                "minWidth": 800,
                "minHeight": 600
            }
        ],
        "security": { "csp": null }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
